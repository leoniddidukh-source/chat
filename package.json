{
  "name": "modular-erp-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @erp/host",
    "dev:host": "npm run dev --workspace @erp/host",
    "dev:default-module": "npm run dev --workspace @modules/default-module",
    "dev:chat-module": "npm run dev --workspace @modules/chat-module",
    "build": "npm run build --workspace @erp/host",
    "build:host": "npm run build --workspace @erp/host",
    "build:default-module": "npm run build --workspace @modules/default-module",
    "build:chat-module": "npm run build --workspace @modules/chat-module",
    "lint": "npm run lint --workspace @erp/host",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:chat-module": "cd modules/chat-module && npm run deploy",
    "deploy:default-module": "cd modules/default-module && npm run build && firebase deploy --only hosting",
    "deploy:all-modules": "npm run deploy:default-module && npm run deploy:chat-module"
  }
}
